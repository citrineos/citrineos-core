# CitrineOS NestJS — local environment template.
#
# Copy to `.env` (or `.env.local` for personal overrides that should
# trump `.env`) and edit. Shell-exported vars take precedence over both.
#
# Defaults match the legacy `Server/docker-compose.yml` Postgres /
# RabbitMQ container (`citrine` user / `citrine` password) so a fresh
# `docker compose up` of the legacy stack lets nestjs run against it
# unchanged.

# ─── Bootstrap: locate system config + DB connection ──────────────────────
# Both halves mirror the legacy `BOOTSTRAP_CITRINEOS_*` envelope so a
# legacy deploy can be flipped to nestjs by swapping the binary.

BOOTSTRAP_CITRINEOS_DATABASE_HOST=localhost
BOOTSTRAP_CITRINEOS_DATABASE_PORT=5432
BOOTSTRAP_CITRINEOS_DATABASE_NAME=citrine
BOOTSTRAP_CITRINEOS_DATABASE_USERNAME=citrine
BOOTSTRAP_CITRINEOS_DATABASE_PASSWORD=citrine

# Where to look for the runtime system-config file (modules, websocket
# servers, AMQP url, webhook URLs, etc). The legacy Server ships a
# canonical example at `Server/data/config.json` — point at it for
# local dev. Production deploys typically mount a tenant-specific
# config file into the container instead.
BOOTSTRAP_CITRINEOS_FILE_ACCESS_TYPE=local
BOOTSTRAP_CITRINEOS_FILE_ACCESS_LOCAL_DEFAULT_FILE_PATH=../Server/data
BOOTSTRAP_CITRINEOS_CONFIG_FILENAME=config.json

# ─── Process metadata ─────────────────────────────────────────────────────
# `APP_ENV=local` resolves to `env=development` internally.
# `APP_NAME=all` runs every module + the router in one process. Other
# values (`router`, `modules`, individual module names) split the
# process for horizontal scaling.

APP_ENV=local
APP_NAME=all

# ─── Optional: system-config overrides ────────────────────────────────────
# Any `CITRINEOS_<NESTED_PATH>=value` env walks the parsed AppConfig
# and overrides that field after the JSON file loads. Mirrors legacy
# `mergeConfigFromEnvVars`. Examples:
#
#   CITRINEOS_UTIL_CACHE_REDIS_HOST=redis
#   CITRINEOS_UTIL_CACHE_REDIS_PORT=6379
#   CITRINEOS_UTIL_AUTHPROVIDER_LOCALBYPASS=true
#   CITRINEOS_UTIL_WEBHOOKS_0_URL=https://operator.example.com/hooks
#   CITRINEOS_LOGLEVEL=2

# ─── Optional: telemetry ──────────────────────────────────────────────────
# OTLP endpoint for trace export. Leave unset to disable.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
