{
  "exclude": ["documentation", "docs"],
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "esModuleInterop": true,
    "paths": {
      "@amqp/*": ["src/modules/amqp/*"],
      "@auth/*": ["src/modules/auth/*"],
      "@cache/*": ["src/modules/cache/*"],
      "@config/*": ["src/config/*"],
      "@db/*": ["src/database/*"],
      "@entities/*": ["src/database/entities/*"],
      "@health/*": ["src/modules/health/*"],
      "@ocpp/*": ["src/ocpp/*"],
      "@enums/*": ["src/enums/*"],
      "@dto/*": ["src/dto/*"],
      "@repositories/*": ["src/repositories/*"],
      "@mappers/*": ["src/mappers/*"],
      "@router/*": ["src/modules/ocpp-router/*"],
      "@modules/*": ["src/modules/*"],
      "@remote-calls/*": ["src/modules/remote-calls/*"],
      "@webhooks/*": ["src/modules/webhooks/*"],
      "@file-storage/*": ["src/modules/file-storage/*"],
      "@certificate-authority/*": ["src/modules/certificate-authority/*"],
      "@logger/*": ["src/logger/*"],
      "@metrics/*": ["src/modules/metrics/*"],
      "@telemetry/*": ["src/telemetry/*"]
    }
  }
}
