{
  "name": "@citrineos/nestjs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm run check:circular && nest build && tsc-alias -p tsconfig.json",
    "check:circular": "madge --circular --extensions ts src/",
    "start": "node dist/src/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand --forceExit",
    "migrate": "ts-node -r tsconfig-paths/register --project tsconfig.json src/migrate.ts",
    "drizzle:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "diff:schema": "ts-node -r tsconfig-paths/register --project tsconfig.json scripts/diff-schema.ts",
    "audit:endpoints": "ts-node -r tsconfig-paths/register --project tsconfig.json scripts/audit-endpoints.ts",
    "dump:legacy-schema": "ts-node -r tsconfig-paths/register --project tsconfig.json scripts/dump-legacy-schema.ts",
    "test:migrate": "ts-node -r tsconfig-paths/register --project tsconfig.json scripts/test-migrate.ts",
    "docs": "compodoc -c .compodocrc.json",
    "docs:serve": "compodoc -c .compodocrc.json -s -w"
  },
  "dependencies": {
    "@nestjs/common": "11.0.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.0.7",
    "@nestjs/platform-fastify": "11.0.7",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/terminus": "^11.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "acme-client": "^5.4.0",
    "amqplib": "1.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.2.1",
    "pg": "8.13.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.20.0",
    "zod": "4.1.2"
  },
  "devDependencies": {
    "@compodoc/compodoc": "^1.2.1",
    "@nestjs/cli": "11.0.7",
    "@nestjs/testing": "11.0.7",
    "@types/amqplib": "0.10.7",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.4",
    "@types/pg": "8.11.11",
    "@types/ws": "8.5.14",
    "drizzle-kit": "0.31.10",
    "jest": "29.7.0",
    "madge": "^8.0.0",
    "testcontainers": "11.14.0",
    "ts-jest": "29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.7.3"
  }
}
