{
  "entryPoints": [
    "./00_Base/src",
    "./01_Data/src",
    "./02_Util/src",
    "./Server/src/citrineOSServer.ts",
    "./Server/src/config",
    "./03_Modules/Certificates/src",
    "./03_Modules/Configuration/src",
    "./03_Modules/EVDriver/src",
    "./03_Modules/Monitoring/src",
    "./03_Modules/OcppRouter/src",
    "./03_Modules/Reporting/src",
    "./03_Modules/SmartCharging/src",
    "./03_Modules/Tenant/src",
    "./03_Modules/Transactions/src"
  ],
  "entryPointStrategy": "expand",
  "tsconfig": "./tsconfig.build.json",
  "out": "./docs/docs/api",
  "plugin": ["typedoc-plugin-markdown"],
  "name": "CitrineOS Core",
  "readme": "none",
  "includeVersion": false,
  "categorizeByGroup": true,
  "excludePrivate": false,
  "excludeExternals": true,
  "searchInComments": true,
  "commentStyle": "jsdoc",
  "skipErrorChecking": true,
  "outputFileStrategy": "modules",
  "fileExtension": ".md",
  "entryFileName": "index",
  "indexFormat": "table",
  "parametersFormat": "table",
  "propertiesFormat": "table",
  "typeDeclarationFormat": "table",
  "mergeReadme": false,
  "hidePageHeader": false,
  "hideBreadcrumbs": false,
  "useCodeBlocks": true
}
