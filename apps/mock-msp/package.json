{
  "name": "@citrineos/mock-msp",
  "version": "0.0.0",
  "description": "Mock eMSP (OCPI 2.2.1) for testing CitrineOS CPO-side OCPI",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.src.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -b tsconfig.src.json --pretty",
    "typecheck:all": "tsc -p tsconfig.json --noEmit --pretty",
    "test": "vitest run",
    "test:live": "vitest run -c vitest.live.config.ts --dir test-live/pr",
    "test:everest": "vitest run -c vitest.live.config.ts --dir test-live/everest",
    "test:e2e": "playwright test --project=dashboard",
    "test:e2e:live": "playwright test --project=dashboard-live",
    "test:e2e:everest": "playwright test --project=dashboard-everest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": "S44",
  "license": "Apache-2.0",
  "dependencies": {
    "@citrineos/base": "workspace:*",
    "@citrineos/ocpi-base": "workspace:*",
    "fastify": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "^1.49.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "engines": {
    "node": ">=24.16.0"
  }
}
