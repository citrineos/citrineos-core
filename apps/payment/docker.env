#
# Settings of the payment server in the local docker stack (`pnpm citrine --payment`). Not for
# production: the secrets below are public. Put your Stripe keys, and anything you want to change,
# in apps/payment/.env.local (see .env.local.example), which overrides this file.
APP_ENV=docker
PAYMENT_PUBLIC_URL=http://localhost:9010
PAYMENT_CALLBACK_SECRET=local-stack-only-callback-secret-0123456789
PAYMENT_ADMIN_API_KEY=local-stack-only-admin-api-key-0123456789
# The stack's Core runs in auth mode localDev: tokens are minted per tenant from its /dev/token.
CORE_AUTH_MODE=localDev
