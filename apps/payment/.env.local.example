#
# Copy to .env.local (ignored by git) and fill in. `pnpm start` loads it, and the docker stack reads it after
# docker.env.
# Your platform's Stripe test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=sk_test_...
# The signing secret of a Connect webhook endpoint, e.g. from
#   stripe listen --forward-connect-to localhost:9010/api/webhooks/stripe
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Signs the callback URLs handed to Core; any random string of at least 32 characters, e.g. from
#   openssl rand -hex 32
# The docker stack sets one in docker.env; uncomment and set it for `pnpm start`.
# PAYMENT_CALLBACK_SECRET=
# How the server authenticates to Core. Unset, `pnpm start` uses localDev: tokens from the local Core's /dev/token.
# Set headers, with CORE_HEADERS, for a Core in another auth mode.
# CORE_AUTH_MODE=localDev
# Optional: platform-wide access to /api/admin, at least 32 characters. docker.env sets one for the stack.
# PAYMENT_ADMIN_API_KEY=
