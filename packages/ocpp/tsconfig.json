{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "composite": true,
    "paths": {
      "@/*": ["./src/*"],
      "@handlers/*": ["./src/handlers/*"],
      "@modules/*": ["./src/modules/*"],
      "@util/*": ["./src/util/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": ["**/*", "**/*.json"],
  "exclude": ["**/dist/**", "**/node_modules/**", "**/vitest.config.ts", "**/test/**"],
  "references": [
    {
      "path": "../types"
    },
    {
      "path": "../dal"
    },
    {
      "path": "../base"
    }
  ]
}
